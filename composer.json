{
  "name": "sugarcommerce/dev-tools",
  "description": "Development checks for the SugarCommerce family and the apps built on it: a docblock coverage report that can gate a build, a headless-Chrome smoke test that loads every page and fails on any console error, and small real demo media (WAV, PNG, PDF, ZIP) made in code, the same bytes on every run.",
  "version": "1.2.0",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/dev-tools",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["docblocks", "lint", "smoke-test", "headless-chrome", "fixtures", "demo-data", "dev"],
  "require": {
    "php": ">=8.5",
    "ext-gd": "*",
    "sugarcommerce/text-pdf": "^1.1",
    "sugarcommerce/zip-stream": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\DevTools\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\DevTools\\Tests\\": "tests/" } },
  "bin": [ "bin/docblocks", "bin/smoke" ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/dev-tools/issues", "source": "https://github.com/sugarcommerce/dev-tools" }
}
